# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-ou-publishable
# Chave secreta (service_role / secret). NUNCA expor no navegador.
SUPABASE_SERVICE_ROLE_KEY=chave-service-role

# Anthropic → console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...
# Modelo usado na leitura das prints (opcional)
ANTHROPIC_MODEL=claude-sonnet-5-5

# Senha exigida na tela /setup para criar o primeiro administrador
SETUP_TOKEN=troque-por-uma-senha-longa

# Domínio interno usado para transformar "usuário" em e-mail no Supabase Auth.
# Nenhum e-mail é enviado. Só altere se o Supabase recusar o domínio.
LOGIN_EMAIL_DOMAIN=capitaes.wzcup.app
